# Apenas configuração local. Valores do Netlify não são copiados automaticamente.
PORT=3000
SUPABASE_URL=https://tjqcltzfqqeveztdumsb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SURI_GEMINI=
# Nome anterior também aceito; preencha somente uma das duas variáveis.
GEMINI_API_KEY=

# Use um modelo disponível na sua conta; JSON e Google Search exigem suporte/cota.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
PUTER_MODEL=gpt-5.4-nano

# Endereço público confirmado e link oficial da escola (não inventar valores).
ESCOLA_ENDERECO=
ESCOLA_FONTE_URL=

# Preencher somente após confirmar o esquema real de conhecimentos.
CONHECIMENTOS_ASSUNTO_COLUNA=
CONHECIMENTOS_RESPOSTA_COLUNA=
CONHECIMENTOS_LOCALIZACAO_ASSUNTO=

# Opcional: chave PUBLISHABLE direta para o login no navegador. Nunca service_role.
# Útil se SUPABASE_PUBLISHABLE_KEY for injetada como placeholder por um proxy.
SUPABASE_AUTH_PUBLISHABLE_KEY=
